(program
    (defmacro defstage ((name) (cap) (in_t) (out_t) (ctx) (rest body))
      (let* ((node
          (quasi
            (const stage_placeholder
              (async-lambda (((unquote ctx) : (unquote cap)))
                (async-generator-fn
                  ((upstream : (AsyncGenerator (unquote in_t))) : (AsyncGenerator (unquote out_t)))
                  (unquote-splicing body)))))))
        (set! (. node name) (. name name))
        (return node)))

    (defmacro deflift ((name) (fn_expr))
      (let* ((node
          (quasi
            (const lift_placeholder
              (pure (lift (unquote fn_expr)))))))
        (set! (. node name) (. name name))
        (return node)))

    (defmacro defpipeline ((name) (rest slots))
      (return
        (quasi
          (const (unquote name)
            (createPipeline
              (array
                (unquote-splicing
                  (map slots (lambda ((slot))
                    (quasi (object
                      (name (unquote (index slot 0)))
                      (stage (unquote (index slot 1))))))))))))))

    (defmacro defcontext ((name) (rest clauses))
      (let* ((slot_clauses   (filter clauses (lambda ((c)) (= (index c 0) :slot))))
             (dispose_clause (find   clauses (lambda ((c)) (= (index c 0) :dispose))))
             (dispose_body  (ternary dispose_clause (index dispose_clause 1) (array)))
             (node
               (quasi
                 (class (unquote name)
                   (implements AsyncDisposable)
                   (class-body
                     (unquote-splicing
                       (map slot_clauses (lambda ((s))
                         (quasi (field (unquote (index s 1)) (unquote (index s 2)))))))
                     (method [(. Symbol asyncDispose)] ()
                       (unquote-splicing dispose_body)))))))
        (return node)))

    (defmacro defcap ((name) (rest methods))
      (let* ((node
          (quasi
            (interface cap_placeholder
              ((unquote-splicing methods))))))
        (set! (. node name) (. name name))
        (return node)))

)
